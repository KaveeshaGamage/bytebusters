FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY Backend/apps/api/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY Backend/apps/api/ ./
COPY db/seed/data/ ./db/seed/data/

EXPOSE 10000

CMD ["sh", "-c", "alembic upgrade head && python -m app.seed.loader && python -m app.seed.day_generator && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000}"]
